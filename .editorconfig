root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,jsonc,yaml,yml}]
indent_size = 2

[*.{js,jsx,ts,tsx,css,scss,html,md,sh}]
indent_size = 2

[*.dart]
indent_size = 2

[*.go]
indent_style = tab
tab_width = 4

[*.{rs,py,ps1}]
indent_size = 4

[Makefile]
indent_style = tab
