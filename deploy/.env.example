RADISHNEXUS_PUBLIC_ORIGIN=https://localhost:8443
RADISHNEXUS_HTTPS_PORT=8443
RADISHNEXUS_POSTGRES_PASSWORD_FILE=./secrets/postgres_password

# These three values are one security boundary. The trusted CIDR must remain
# the proxy address with a /32 mask.
RADISHNEXUS_PROXY_SUBNET=172.30.73.0/24
RADISHNEXUS_PROXY_IPV4=172.30.73.10
RADISHNEXUS_TRUSTED_PROXY_CIDR=172.30.73.10/32

# Set these to the host account that owns deploy/local-data/backups on Linux.
RADISHNEXUS_OPERATION_UID=1000
RADISHNEXUS_OPERATION_GID=1000
