{
	admin off
	auto_https disable_redirects
	skip_install_trust
}

{$RADISHNEXUS_PUBLIC_ORIGIN} {
	tls internal

	log {
		output stdout
		format json
	}

	reverse_proxy app:8080 {
		header_up Host {hostport}
		header_up X-Forwarded-Proto https

		health_uri /health/ready
		health_interval 10s
		health_timeout 2s

		transport http {
			dial_timeout 3s
			response_header_timeout 20s
		}
	}
}
